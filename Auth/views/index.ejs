<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full h-screen bg-zinc-900 text-white p-10">
        <h3 class="text-xl font-bold mb-5">Create User</h3>
        <form method = "post" action="/create">
            <input Class = px-3 py-2 rounded-md bg transparent border-2 border-zinc-800 outline-none type="text" name="email" placeholder="Email">
            <input Class = px-3 py-2 rounded-md bg transparent border-2 border-zinc-800 outline-none type="password" name="password" placeholder="Password">
            <button class="bg-blue-500 text-white py-2 px-4 rounded-md mt-5">Create User</button>
        </form>
    </div>
</body>
</html>